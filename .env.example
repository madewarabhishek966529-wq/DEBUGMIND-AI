# DebugMind AI Environment Configuration

# Google Gemini API Key (Required for live AI features, leave empty for offline mock mode)
GEMINI_API_KEY=

# Gemini Model name (configurable, e.g., gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Backend Server Port
SERVER_PORT=8080

# Optional Database Persistence (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/debugmind
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Process Sandbox Settings
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_TEMP_DIR=
